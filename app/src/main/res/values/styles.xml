<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextTitle" parent="">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="TextSubtitle" parent="">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="TextBody" parent="">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="TextHint" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <!-- Katta, bosish oson tugmalar (kamida 64dp) -->
    <style name="ButtonBig" parent="android:Widget.Material.Button">
        <item name="android:minHeight">64dp</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="ButtonBigPrimary" parent="ButtonBig">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/on_primary</item>
    </style>

    <style name="ButtonBigOutline" parent="ButtonBig">
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="android:textColor">@color/primary</item>
    </style>
</resources>
